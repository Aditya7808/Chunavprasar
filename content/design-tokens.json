    },
    "slate": {
      "600": { "value": "#28364F", "type": "color", "description": "Hairline card borders and dividers" },
      "400": { "value": "#64748B", "type": "color", "description": "Muted metadata labels" },
      "300": { "value": "#94A3B8", "type": "color", "description": "Subheadline text in dark sections" }
    },
    "gold": {
      "500": { "value": "#C69A45", "type": "color", "description": "Primary gold accent (~10% visual ratio, CTAs, dividers)" },
